generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentLinkStatus {
  ACTIVE
  ARCHIVED
}

enum TransactionStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum ReceiptStatus {
  PENDING
  ISSUED
  FAILED
}

enum LedgerEntryType {
  CLIENT_PAYMENT_RECEIVED
  TAX_RESERVED
  PLATFORM_FEE_RESERVED
  SELF_EMPLOYED_BALANCE
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
}

enum CatalogItemType {
  SERVICE
  PRODUCT
}

enum CatalogItemUnit {
  PIECE
  HOUR
  MINUTE
  DAY
  SET
}

enum CatalogItemPaymentPolicy {
  NO_PREPAYMENT
  FIXED_PREPAYMENT
  PERCENT_PREPAYMENT
  FULL_PREPAYMENT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum OfficialCalendarDayType {
  HOLIDAY
  WORKING_DAY
}

enum CalendarDateOverrideType {
  CLOSED
  OPEN
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BookingItemType {
  SERVICE
  PRODUCT
}

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_REMINDER
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
}

enum NotificationChannel {
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  publicSlug   String    @unique
  passwordHash String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions               Session[]
  catalogItems           CatalogItem[]
  weeklyWorkingHours     WeeklyWorkingHours[]
  calendarDateOverrides  CalendarDateOverride[]
  bookings               Booking[]
  notifications          Notification[]
  paymentLinks           PaymentLink[]
  transactions           Transaction[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model WeeklyWorkingHours {
  id           String    @id @default(cuid())
  ownerId      String
  dayOfWeek    DayOfWeek
  isWorking    Boolean
  startMinutes Int?
  endMinutes   Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@unique([ownerId, dayOfWeek])
  @@index([ownerId])
}

model OfficialCalendarDay {
  id        String                  @id @default(cuid())
  date      DateTime                @db.Date @unique
  type      OfficialCalendarDayType
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
}

model CalendarDateOverride {
  id           String                   @id @default(cuid())
  ownerId      String
  date         DateTime                 @db.Date
  type         CalendarDateOverrideType
  startMinutes Int?
  endMinutes   Int?
  reason       String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@unique([ownerId, date])
  @@index([ownerId])
}

model CatalogItem {
  id                  String                   @id @default(cuid())
  ownerId             String
  title               String
  description         String?
  type                CatalogItemType
  isActive            Boolean                  @default(true)
  isBookable          Boolean                  @default(true)
  price               Int?
  durationMinutes     Int?
  bufferBeforeMinutes Int                      @default(0)
  bufferAfterMinutes  Int                      @default(0)
  unit                CatalogItemUnit?
  paymentPolicy       CatalogItemPaymentPolicy?
  prepaymentValue     Int?
  category            String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  bookingItems BookingItem[]

  @@index([ownerId])
}

model Booking {
  id                   String        @id @default(cuid())
  ownerId              String
  bookingDate          DateTime      @db.Date
  startMinutes         Int
  serviceEndMinutes    Int
  reservedStartMinutes Int
  reservedEndMinutes   Int
  status               BookingStatus @default(CONFIRMED)
  totalAmount          Int
  customerName         String
  customerPhone        String?
  customerEmail        String?
  comment              String?
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  owner User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  items BookingItem[]
  notifications Notification[]

  @@index([ownerId])
  @@index([status])
  @@index([bookingDate, status, reservedStartMinutes, reservedEndMinutes])
}

model Notification {
  id              String              @id @default(cuid())
  ownerId         String
  bookingId       String
  type            NotificationType
  channel         NotificationChannel @default(EMAIL)
  status          NotificationStatus  @default(PENDING)
  recipient       String
  scheduledFor    DateTime
  sentAt          DateTime?
  failedAt        DateTime?
  cancelledAt     DateTime?
  failureReason   String?
  payloadSnapshot Json
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([ownerId, bookingId])
  @@index([status, scheduledFor])
}

model BookingItem {
  id                  String          @id @default(cuid())
  bookingId           String
  position            Int
  catalogItemId       String
  type                BookingItemType
  title               String
  description         String?
  unitPrice           Int
  quantity            Int
  lineTotalAmount     Int
  unit                CatalogItemUnit?
  durationMinutes     Int?
  bufferBeforeMinutes Int?
  bufferAfterMinutes  Int?
  createdAt           DateTime        @default(now())

  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([catalogItemId])
}

model PaymentLink {
  id           String            @id @default(cuid())
  ownerId      String
  title        String
  amount       Int
  payerType    String
  status       PaymentLinkStatus @default(ACTIVE)
  createdAt    DateTime          @default(now())

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  payments     Payment[]

  @@index([ownerId])
}

model Payment {
  id                String        @id @default(cuid())

  provider          String
  externalPaymentId String        @unique
  paymentUrl        String?
  amount            Int
  status            PaymentStatus @default(CREATED)

  paymentLinkId     String
  paymentLink       PaymentLink   @relation(fields: [paymentLinkId], references: [id])

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([provider])
  @@index([paymentLinkId])
}

model Transaction {
  id                String            @id @default(cuid())
  ownerId           String
  title             String
  client            String
  grossAmount       Int
  taxAmount         Int
  platformFeeAmount Int               @default(0)
  netAmount         Int
  date              String
  status            TransactionStatus @default(RECEIVED)
  createdAt         DateTime          @default(now())

  externalPaymentId String?
  externalStatus    String?

  owner             User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  paymentLinkId     String?
  paymentLink       PaymentLink?      @relation(fields: [paymentLinkId], references: [id])

  receipt           Receipt?
  ledgerEntries     LedgerEntry[]

  @@index([ownerId])
  @@index([externalPaymentId])
}

model Receipt {
  id            String        @id @default(cuid())
  title         String
  client        String
  amount        Int
  status        ReceiptStatus @default(PENDING)
  date          String
  createdAt     DateTime      @default(now())

  transactionId String?       @unique
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])
}

model LedgerEntry {
  id            String          @id @default(cuid())

  transactionId String
  transaction   Transaction     @relation(fields: [transactionId], references: [id])

  type          LedgerEntryType
  direction     LedgerDirection
  amount        Int

  createdAt     DateTime        @default(now())
}

model WebhookEvent {
  id                String             @id @default(cuid())

  provider          String
  eventType         String?
  externalPaymentId String?
  idempotencyKey    String?

  status            WebhookEventStatus @default(RECEIVED)
  payload           Json

  errorMessage      String?
  processedAt       DateTime?
  createdAt         DateTime           @default(now())

  @@index([provider])
  @@index([externalPaymentId])
  @@unique([provider, idempotencyKey])
}